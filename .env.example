# Plataforma Multi-Agente Reto 3 — Variables de entorno (plantilla)
# Copiar como .env y ajustar si es necesario.
RABBITMQ_URL=amqp://agentuser:agentpass@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0
PG_DSN=host=localhost port=5433 dbname=agentdb user=agentuser password=agentpass
LOG_LEVEL=INFO
SUITECRM_URL=http://suitecrm:8080
SUITECRM_USER=admin
SUITECRM_PASS=Admin1234
SUITECRM_SIM=false
AGENT_TIMEOUT_SECS=60
AGENT_TIMEOUT_RETRIES=2
PIPELINE_WAIT=15
